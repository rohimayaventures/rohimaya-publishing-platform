# OpenAI API Configuration (Primary TTS Provider)
[openai]
api_key = "sk-xxxxx"

# Optional providers (for future enhancement)
[inworld]
api_key = "your_inworld_key"

[elevenlabs]
api_key = "your_elevenlabs_key"

# Setup Instructions:
# 1. Copy this file to secrets.toml in the same directory
# 2. Replace the placeholder API keys with your actual keys
# 3. For now, only OpenAI is required (most reliable)
#
# How to get OpenAI API key:
# - Visit https://platform.openai.com/
# - Sign up or log in
# - Go to API Keys section
# - Create new secret key
# - Copy and paste above (replace sk-xxxxx)
#
# Security Notes:
# - Never commit secrets.toml to version control
# - Keep your API keys private and secure
# - Set spending limits in OpenAI dashboard
# - Rotate keys periodically
# - Monitor usage regularly
